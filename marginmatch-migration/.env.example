# Database — use DATABASE_URL for ordinary PostgreSQL, or Supabase/PostgREST below.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments
STRIPE_RESTRICTED_KEY=

# Email
RESEND_API_KEY=

# SMS / dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI provider (portable adapter milestone)
OPENAI_API_KEY=

# Runtime selection
MARGINMATCH_DATABASE=postgres
MARGINMATCH_SECRETS=env

# Auth / AI
AUTH_VERIFY_URL=
OPENAI_MODEL=gpt-5-mini

# Portable Stripe test checkout URLs
MATTRESS_SUCCESS_URL=http://localhost:3000/
MATTRESS_CANCEL_URL=http://localhost:3000/

# Migration-only outbound messaging gates
ENABLE_OUTBOUND_TEST_EMAILS=false
TEST_EMAIL_ALLOWLIST=
MATTRESS_FROM_EMAIL=Mattress Rescue <orders@mattressrescue.com>

ENABLE_OUTBOUND_TEST_SMS=false
TEST_SMS_ALLOWLIST=

# Portable driver proof storage
SUPABASE_PROOF_BUCKET=marginmatch-proof
PORTABLE_PUBLIC_URL=http://localhost:3000

# Portable owner authentication
PORTABLE_ADMIN_ACCESS_KEY=
PORTABLE_SESSION_SECRET=
ADMIN_EMAIL_ALLOWLIST=

# Legacy backend compatibility fallback
# Keep false until /api/legacy-compat-self-test and parity tests pass.
ENABLE_LEGACY_PORTABLE_ROUTES=false

# Additional legacy compatibility safety locks
ENABLE_LEGACY_EXTERNAL_MESSAGING=false
ENABLE_LEGACY_LIVE_PAYMENTS=false

# Full legacy portfolio compatibility gates
VITE_ENABLE_LEGACY_PORTFOLIO=false
LEGACY_PORTFOLIO_PARITY_APPROVED=false

# Optional S3-compatible storage instead of Supabase Storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

STRIPE_LIVE_SECRET_KEY=
ENABLE_LIVE_MATTRESS_PAYMENTS=false
MATTRESS_PUBLIC_URL=https://mattressrescue.com
