{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main.tsx",
    "src/platform-client.ts",
    "src/DriverJob.tsx",
    "src/ContractorApply.tsx",
    "src/ContractorPortal.tsx",
    "src/ContractorAdmin.tsx",
    "src/MattressRescueStorefront.tsx",
    "src/MattressQualification.tsx",
    "src/OwnerCockpit.tsx",
    "src/ExceptionDashboard.tsx",
    "src/PortableLogin.tsx",
    "src/MigrationControl.tsx",
    "src/PortableOperations.tsx",
    "src/PortableHome.tsx",
    "src/DataMigration.tsx",
    "src/SystemHealth.tsx",
    "server.ts",
    "api/**/*.ts",
    "backend/index.ts",
    "backend/platform.ts",
    "backend/http-portable.ts",
    "backend/portable-api.ts",
    "backend/portable-runtime.ts",
    "backend/platform-postgres.ts",
    "backend/secrets-env.ts",
    "backend/ai-openai.ts",
    "backend/auth-portable.ts",
    "backend/stripe-test.ts",
    "backend/resend-portable.ts",
    "backend/twilio-portable.ts",
    "backend/storage-supabase.ts",
    "backend/storage-s3.ts",
    "backend/storage-portable.ts",
    "backend/observability.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
