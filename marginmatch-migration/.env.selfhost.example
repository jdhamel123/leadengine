# Required for docker compose
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=marginmatch-storage
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
PORTABLE_ADMIN_ACCESS_KEY=replace-with-a-long-random-access-key
PORTABLE_SESSION_SECRET=replace-with-a-long-random-session-secret
ADMIN_EMAIL_ALLOWLIST=owner@example.com
PORTABLE_PUBLIC_URL=http://localhost:3000

# Optional during migration
STRIPE_RESTRICTED_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=

# Public HTTPS
PUBLIC_DOMAIN=portable.example.com
ACME_EMAIL=owner@example.com

# Operations
BACKUP_RETENTION_DAYS=14
SCHEDULED_ADMIN_EMAIL=owner@example.com

# Keep legacy portfolio locked until compatibility parity is explicitly approved
VITE_ENABLE_LEGACY_PORTFOLIO=false
